#!/bin/sh
# Installs github-setup for the current user, for: curl -fsSL <raw-url>/install | sh
# Installs under $HOME (no sudo, works even when the system npm prefix is root-owned/read-only).
set -e

REPO="revadeio/github-setup"
BIN="github-setup"
PREFIX="${GITHUB_SETUP_INSTALL_PREFIX:-$HOME/.local}"

if ! command -v node >/dev/null 2>&1; then
  echo "error: node (>=18) is required — https://nodejs.org — but wasn't found on PATH" >&2
  exit 1
fi
if ! command -v npm >/dev/null 2>&1; then
  echo "error: npm is required but wasn't found on PATH (usually ships with node)" >&2
  exit 1
fi

mkdir -p "$PREFIX/lib" "$PREFIX/bin"

echo "Installing $BIN from github.com/$REPO into $PREFIX ..."
npm install -g --prefix "$PREFIX" "git+https://github.com/$REPO.git"

if [ -e "$PREFIX/bin/$BIN" ]; then
  echo "Installed: $PREFIX/bin/$BIN"
else
  echo "npm reported success but $PREFIX/bin/$BIN wasn't created — please file an issue." >&2
  exit 1
fi

case ":$PATH:" in
  *":$PREFIX/bin:"*) ;;
  *) echo "note: $PREFIX/bin is not on your PATH yet. Add it, e.g.: export PATH=\"$PREFIX/bin:\$PATH\"" ;;
esac
